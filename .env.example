# ---------- General ----------
APP_NAME=Civic Mirror
LOG_LEVEL=INFO
UPLOAD_DIR=uploads
PROCESSED_DIR=processed
MODELS_DIR=models
MAX_UPLOAD_MB=500
ALLOWED_EXTENSIONS=.mp4,.avi,.mov,.mkv,.webm,.m4v
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# auto | cpu | cuda | cuda:0
DEVICE=auto
USE_HALF=true
# Run inference every Nth frame (annotations are reused on skipped frames)
FRAME_STRIDE=1
MAX_CONCURRENT_JOBS=1
# false: process with whichever models loaded; true: fail if any model is missing
REQUIRE_ALL_MODELS=false
# Output video
OUTPUT_CODEC=mp4v
# Re-encode to browser-playable H.264 if ffmpeg is on PATH
REENCODE_H264=true
FFMPEG_PATH=ffmpeg
DRAW_CONTEXT_OBJECTS=true

# ---------- Helmet model ----------
HELMET_MODEL_PATH=models/helmet.pt
HELMET_CONF=0.40
HELMET_IOU=0.45
HELMET_IMGSZ=640
# Class names (or numeric ids) that mean "rider WITHOUT helmet". Check GET /api/health for your model's classes.
HELMET_VIOLATION_CLASSES=
HELMET_MIN_HITS=3
HELMET_TRACK_IOU=0.30
HELMET_TRACK_MAX_AGE=15

# ---------- Tripling model ----------
TRIPLING_MODEL_PATH=models/tripling.pt
TRIPLING_CONF=0.40
TRIPLING_IOU=0.45
TRIPLING_IMGSZ=640
# Class that directly means "triple riding" (if your model has one)
TRIPLING_VIOLATION_CLASSES=
# Optional person/motorcycle association path (needs both set)
TRIPLING_PERSON_CLASSES=
TRIPLING_MOTORCYCLE_CLASSES=
TRIPLING_MIN_RIDERS=3
TRIPLING_ASSOC_OVERLAP=0.50
TRIPLING_MOTO_EXPAND_X=0.15
TRIPLING_MOTO_EXPAND_UP=0.80
TRIPLING_MIN_HITS=3
TRIPLING_TRACK_IOU=0.30
TRIPLING_TRACK_MAX_AGE=15

# ---------- Red-light model ----------
RED_LIGHT_MODEL_PATH=models/red_light.pt
RED_LIGHT_CONF=0.40
RED_LIGHT_IOU=0.45
RED_LIGHT_IMGSZ=640
# Classes meaning a red traffic signal
RED_LIGHT_RED_SIGNAL_CLASSES=
# Vehicle classes to track for stop-line crossing
RED_LIGHT_VEHICLE_CLASSES=
# Optional: class the model emits directly for violations (reported as UNVERIFIED candidate only)
RED_LIGHT_VIOLATION_CLASSES=
# Stop line as normalized coordinates x1,y1,x2,y2 (0..1). Required for confirmed red-light violations.
RED_LIGHT_STOP_LINE=
# any | positive_to_negative | negative_to_positive
RED_LIGHT_CROSSING_DIRECTION=any
RED_LIGHT_SIGNAL_WINDOW=5
RED_LIGHT_SIGNAL_MIN_RED=3
RED_LIGHT_MIN_TRACK_FRAMES=3
RED_LIGHT_LINE_MARGIN=0.10
RED_LIGHT_TRACK_IOU=0.30
RED_LIGHT_TRACK_MAX_AGE=15
